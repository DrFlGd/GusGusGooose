{
  "name": "gusgusgoose",
  "version": "0.1.0",
  "private": true,
  "description": "Fit magnet-mounted accessories to the Gus Gus desk goose",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "desktop": "tauri dev",
    "desktop:build": "tauri build",
    "tauri": "tauri",
    "smoke": "vite build && node scripts/smoke.mjs",
    "smoke:library": "vite build && node scripts/library-smoke.mjs",
    "detect": "node src/cli.ts detect",
    "fit": "node src/cli.ts fit",
    "hole": "node src/cli.ts hole",
    "build-goose": "node src/build-goose.ts goose/goose.3mf goose/goose.stl --voids goose/goose-voids.3mf",
    "build-slots": "node src/build-slots.ts --out goose/goose-slots.3mf",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "d3-contour": "^4.0.2",
    "manifold-3d": "^3.5.4",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/d3-contour": "^3.0.6",
    "@types/node": "^22.20.5",
    "@types/three": "^0.170.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.11"
  }
}
